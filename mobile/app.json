{
  "expo": {
    "name": "Travel Checkin App",
    "slug": "travel-checkin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "travelcheckin",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập thư viện ảnh để lưu vé QR về điện thoại.",
          "savePhotosPermission": "Ứng dụng cần quyền lưu ảnh để tải vé QR về điện thoại.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travelcheckin.app"
    },
    "android": {
      "package": "com.travelcheckin.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "style": "dark",
        "hidden": false,
        "enforceContrast": false
      },
      "eas": {
        "projectId": "f30225f4-1735-4399-a9f9-e3e11de9ae57"
      }
    },
    "owner": "minh2244"
  }
}
